FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSchemes;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

ddtSchemes
{
    default         Euler;//CrankNicolson 1;
    // ddt(theta,C)    backward;
    // ddt(C)          backward;
    ddt(h)          Euler;
    ddt(theta)      Euler;
}

gradSchemes
{
    default         Gauss linear;
}

divSchemes
{
    default         Gauss linear;
    div(phi,C)      Gauss linear;
}

laplacianSchemes
{
    default         	Gauss linear orthogonal;
}

interpolationSchemes
{
    default		linear;
    K			linear;
    pc   		linear;
    krtheta     linear;
}

snGradSchemes
{
    default         orthogonal;
}

fluxRequired
{
    default         no;
    p           ;
}

