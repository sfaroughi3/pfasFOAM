FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      C_aq;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 -3 0 0 1 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            codedFixedValue;
        value           uniform 0;
        name            Cinjection;

        codeInclude
        #{
            #include "fvCFD.H"
        #};
        codeOptions
        #{
            -I$(LIB_SRC)/finiteVolume/lnInclude \
            -I$(LIB_SRC)/meshTools/lnInclude
        #};
        codeLibs
        #{
            -lfiniteVolume \
            -lmeshTools
        #};

        code
        #{
            const fvPatch& boundaryPatch = patch();
            const vectorField& Cf = boundaryPatch.Cf();
            scalarField& field = *this;
            scalar t = this->db().time().value();

            if (t <= 120000)
            {
                forAll(Cf, faceI)
                {
                    field[faceI] = 0;
                }
            } else
            {
                forAll(Cf, faceI)
                {
                    field[faceI] = 1;
                }
            }
        #};
    }

    outlet
    {
        type            zeroGradient;
    }
    sides
    {
        type            zeroGradient;
    }
    waterside
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}

