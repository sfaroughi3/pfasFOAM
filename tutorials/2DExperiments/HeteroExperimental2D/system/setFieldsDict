FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue h -3
);

regions
(
    boxToCell
    {
        box (1.35 0 0) (2 1 3);
        fieldValues
        (
            volScalarFieldValue h -3
        );
    }
);
