FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     pfasFOAM;

startFrom       startTime;

startTime       0.0;

stopAt          endTime;

endTime         300000.0;//3000000.0;//300000.0;//210000;//28800; // 415585

deltaT          1;

writeControl    adjustableRunTime;

writeInterval   300;//600; // 15000

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression no;

timeFormat      general;

timePrecision   6;

adjustTimeStep  yes;

runTimeModifiable yes;

maxDeltaT	50;

//- for tracer time step control
truncationError 0.1;
truncationError_C 0.1;
truncationError_h 0.01;
//minDeltaT 0.01;
dTFactEvent 0.001;

CSVoutput  false;

eventTimeTracking true;

// ************************************************************************* //
