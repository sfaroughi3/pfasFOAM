FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      C_aq;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 -3 0 0 1 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            codedMixed;
        refValue        uniform 0;
        refGradient     uniform 0;
        valueFraction   uniform 1;
        value           uniform 0;
        name            CinjectionMixed;

        codeInclude
        #{
            #include "fvCFD.H"
        #};
        codeOptions
        #{
            -I$(LIB_SRC)/finiteVolume/lnInclude \
            -I$(LIB_SRC)/meshTools/lnInclude
        #};
        codeLibs
        #{
            -lfiniteVolume \
            -lmeshTools
        #};

        code
        #{
            const scalar t = this->db().time().value();

            if (t <= 120000)
            {
                this->refValue() = 0.0;
                this->refGrad() = 0.0;
                this->valueFraction() = 1.0;
            }
            else if (t <= 210000)
            {
                this->refValue() = 1.0;
                this->refGrad() = 0.0;
                this->valueFraction() = 1.0;
            }
            else
            {
                this->refValue() = 0.0;
                this->refGrad() = 0.0;
                this->valueFraction() = 0.0;
            }
        #};
    }
    outlet
    {
        type            zeroGradient;
    }
    sides
    {
        type            zeroGradient;
    }
    waterside
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}

