FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volScalarFieldValue K 2.10e-4 //6.72e-7
);

regions
(
    boxToCell
    {
        box (0 0 4) (5 5 5); //set region close to y=0 to have higher pemeability
        fieldValues
        (
            volScalarFieldValue K 2.10e-4
        );
    }
    boxToCell
    {
        box (0 0 3) (5 5 4); //set the rest of the layer to higher permeability
        fieldValues
        (
            volScalarFieldValue K 4.10e-5
        );
    }
    boxToCell
    {
        box (0 0 2) (5 5 3); //obstruction from y=0 to y=80 (normal to x=0 face)
        fieldValues
        (
            volScalarFieldValue K 2.10e-4  // 9.72e-4
        );
    }
    boxToCell
    {
        box (0 0 1) (5 5 2); // obstruction from x=0 to x=150 (through the y=0 and y=150 faces)
        fieldValues
        (
            volScalarFieldValue K 4.10e-5 // 9.72e-4
        );
    }
);
