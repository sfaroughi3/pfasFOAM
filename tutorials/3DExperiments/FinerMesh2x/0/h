FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      h;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 0 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    bottom
    {
        type            fixedValue;
        value           uniform 0;
    }

    sides
    {
        type            darcyGradPressure;
        value           uniform -3;
    }
    watertablesides
    {
        type            darcyGradPressure;
        value           uniform -3;
    }

    topInject
    {
        type            darcyGradPressure;
        value           uniform -3;
    }

    topNoFlux
    {
        type            darcyGradPressure;
        value           uniform -3;
    }
}

