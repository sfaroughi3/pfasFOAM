FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      Utheta;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    sides
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }
    topInject
    {
        type            eventInfiltration;
        constantValue   0;
        eventFile       "waterinjection.dat";
        value           uniform (0 0 0);
    }
    topNoFlux
    {
        type            eventInfiltration;
        constantValue   0;
        eventFile       "waterinjection.dat";
        value           uniform (0 0 0);
    }
    watertablesides
    {
        type            fixedValue;
        value           uniform (0 0 0);
    }

    bottom
    {
        type            zeroGradient;
    }
}

