FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      C_aq;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 -3 0 0 1 0 0];

internalField   uniform 0;

boundaryField
{
    sides
    {
        type            zeroGradient;
    }

    bottom
    {
        type            zeroGradient;
    }

    topInject
    {
        type            codedFixedValue;
        value           uniform 0;
        name            pfasPulse;

        code
        #{
            scalarField& field = *this;
            scalar t = this->db().time().value();
            const scalar tstop = 864000.0;
            const scalar cycleTime = 86400.0;
            scalar wheninday = fmod(t, cycleTime);
            const scalar thour = 7200.0;

            if (t < tstop)
            {
                field = scalarField(this->patch().size(), 1.0);
            } else
            {
                field = scalarField(this->patch().size(), 1.0);
            }

        #};
    }
    watertablesides
    {
        type            zeroGradient;
    }
    topNoFlux
    {
        type            fixedValue;
        value           uniform 0;
    }
}

