FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "constant";
    object      K;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 0 0 0 0 0];

// Any positive K gives the same hydrostatic field (no flow)
internalField   uniform 1e-4;

boundaryField
{
    ".*"
    {
        type            calculated;
        value           uniform 1e-4;
    }
}

