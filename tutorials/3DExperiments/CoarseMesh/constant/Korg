FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "constant";
    object      K;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 0 0 0 0 0];

internalField   uniform 2.10e-4;

boundaryField
{
    bottom
    {
        type            zeroGradient;
    }

    topInject
    {
        type            zeroGradient;
    }

    topNoFlux
    {
        type            zeroGradient;
    }

    watertablesides
    {
        type            zeroGradient;
    }

    sides
    {
        type            zeroGradient;
    }
}

