FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// darcyFoam solves for pressure [Pa]; with rho = mu = |g| = 1 the values equal h [m]
dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    bottom
    {
        type            fixedValue;
        value           uniform 0;
    }
    ".*"
    {
        type            darcyGradPressure;
        value           uniform 0;
    }
}

