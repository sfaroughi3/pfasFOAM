FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     pfasFOAM;

startFrom       startTime;

startTime       0.0;

stopAt          endTime;

endTime         5.0;

deltaT          1e-8;

writeControl    adjustableRunTime;

writeInterval   0.5;

purgeWrite      0;

writeFormat     ascii;

writePrecision  8;

writeCompression no;

timeFormat      general;

timePrecision   10;

adjustTimeStep  yes;

runTimeModifiable yes;

maxDeltaT	1e-4;
minDeltaT   1e-15;
dTFactEvent 1;
dTFactIncrease 1.5;
dTFactDecrease 0.5;

//- for tracer time step control
truncationError 0.01;
truncationError_C 0.01;
truncationError_h 0.01;

CSVoutput  true;

eventTimeTracking true;

// ************************************************************************* //
