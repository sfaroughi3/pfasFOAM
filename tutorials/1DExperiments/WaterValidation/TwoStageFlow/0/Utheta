FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    location    "0";
    object      Utheta;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet
    {

        type            codedFixedValue;
        value           uniform (-0.1 0 0);
        name            changeWater;

        codeInclude     #{
            #include "fvCFD.H"
        #};
        codeOptions     #{
            -I$(LIB_SRC)/finiteVolume/lnInclude \
            -I$(LIB_SRC)/meshTools/lnInclude
        #};
        codeLibs        #{
            -lfiniteVolume \
            -lmeshTools
        #};

        code            #{
            const fvPatch& boundaryPatch = patch();
            const vectorField& Cf = boundaryPatch.Cf();
            vectorField& field = *this;
            scalar t = this->db().time().value();
            if (t < 10)
            {
                forAll(Cf, faceI)
                {
                    field[faceI] = vector(0, 0, 0);
                }
            }
            else if (t < 24)
            {
                forAll(Cf, faceI)
                {
                    field[faceI] = vector(-0.1, 0, 0);
                }
            }else
            {
            forAll(Cf, faceI)
                {
                    field[faceI] = vector(-0.9, 0, 0);
                }
            }
        #};
    }
    outlet
    {
        type            zeroGradient;
    }
    frontAndBack
    {
        type            empty;
    }
}

